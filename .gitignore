# The root launcher, anchored, with the package directory re-included after
# it: ignore matching is case-insensitive on Windows and macOS, so /mavproxy
# also matches MAVProxy/ and would hide the whole package tree from git.
/mavproxy
!/MAVProxy/
*~
*.o
*.pyc
*.log
camera/
build/
dist/
gtest/
*.tlog
*.raw
MANIFEST
*.egg-info
.DS_Store
*.bak
*.orig
windows/version.txt
/.vscode
